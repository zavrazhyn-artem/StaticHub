# =============================================================================
# Local-dev FrankenPHP config — overrides /etc/frankenphp/Caddyfile via a
# bind mount in docker-compose.yml. Differs from prod only in that workers
# auto-reload on PHP/blade/.env file changes (inotify watch). NEVER ship
# this in a prod image — file watching adds overhead and the watch patterns
# don't apply to immutable container filesystems anyway.
# =============================================================================

{
    {$CADDY_GLOBAL_OPTIONS}

    frankenphp {
        worker {
            file /var/www/html/public/frankenphp-worker.php
            num {$OCTANE_WORKERS:4}

            # Auto-reload workers on edits — gives instant edit-to-effect
            # in local dev without manual `docker compose restart app`.
            watch /var/www/html/app/**/*.php
            watch /var/www/html/routes/**/*.php
            watch /var/www/html/config/**/*.php
            watch /var/www/html/resources/views/**/*.php
            watch /var/www/html/bootstrap/app.php
            watch /var/www/html/.env
        }
    }
}

{$SERVER_NAME:":80"} {
    root * /var/www/html/public

    encode zstd br gzip

    handle /up {
        respond "OK" 200
    }

    @asset {
        path /build/* /favicon.ico /robots.txt
    }
    handle @asset {
        header Cache-Control "public, max-age=31536000, immutable"
        file_server
    }

    php_server

    log {
        output stdout
        format console
        level INFO
    }
}
