# =============================================================================
# FrankenPHP server config for the BlastR app.
#
# Runs the Laravel app in Octane worker mode — workers stay resident, no
# bootstrap per request. Behind a k8s Ingress in production (so TLS is
# terminated upstream); locally Caddy can serve plain HTTP on :80.
# =============================================================================

{
    # Bind FrankenPHP server-name from env so local + prod can use the same
    # config without rewrites. SERVER_NAME=:80 is the default in our Dockerfile.
    {$CADDY_GLOBAL_OPTIONS}

    frankenphp {
        # Number of resident worker processes. Each handles one request at a
        # time but stays warm — no Laravel boot cost. Tune via env in k8s.
        # As a rule of thumb: 1-2× CPU cores. Override per container.
        worker {
            file /var/www/html/public/frankenphp-worker.php
            num {$OCTANE_WORKERS:4}
        }
    }
}

{$SERVER_NAME:":80"} {
    root * /var/www/html/public

    encode zstd br gzip

    # k8s liveness/readiness — short-circuit before PHP for cheap probes.
    handle /up {
        respond "OK" 200
    }
    handle /healthz {
        respond "OK" 200
    }

    # Static assets — long cache, served by Caddy without invoking PHP.
    # Vite output already has content-hash in filenames so safe to immutable.
    @asset {
        path /build/* /favicon.ico /robots.txt
    }
    handle @asset {
        header Cache-Control "public, max-age=31536000, immutable"
        file_server
    }

    # Everything else → Laravel via FrankenPHP worker.
    php_server

    log {
        output stdout
        format console
        level INFO
    }
}
