# =============================================================================
# Caddy config for the service droplet — terminates TLS for obs.blastr.pro
# and reverse-proxies to GlitchTip + Grafana + admin tools.
#
# TLS cert: Cloudflare Origin wildcard *.blastr.pro mounted from
# /etc/ssl/cloudflare/ on the host (same cert reused across k8s + service).
# =============================================================================

{
    # Disable Caddy's automatic Let's Encrypt — we use CF origin cert.
    auto_https off
}

# HTTP → HTTPS redirect (CF proxy also handles this, belt-and-suspenders).
:80 {
    redir https://{host}{uri} permanent
}

k8s.blastr.pro:443 {
    tls /etc/ssl/cloudflare/cloudflare-origin.fullchain.pem /etc/ssl/cloudflare/cloudflare-origin.privkey.pem
    reverse_proxy headlamp:4466
}

db.blastr.pro:443 {
    tls /etc/ssl/cloudflare/cloudflare-origin.fullchain.pem /etc/ssl/cloudflare/cloudflare-origin.privkey.pem
    reverse_proxy adminer:8080
}

redis.blastr.pro:443 {
    tls /etc/ssl/cloudflare/cloudflare-origin.fullchain.pem /etc/ssl/cloudflare/cloudflare-origin.privkey.pem
    reverse_proxy redisinsight:5540
}

obs.blastr.pro:443 {
    tls /etc/ssl/cloudflare/cloudflare-origin.fullchain.pem /etc/ssl/cloudflare/cloudflare-origin.privkey.pem

    handle /grafana/* {
        reverse_proxy grafana:3000
    }

    # Loki push endpoint — used by Promtail DaemonSet in DOKS.
    # Pods reach this via HTTPS since direct VPC routing is not available.
    handle /loki/* {
        reverse_proxy loki:3100
    }

    # GlitchTip at root.
    handle {
        reverse_proxy glitchtip-web:8000
    }

    log {
        output stdout
        format console
        level INFO
    }
}
