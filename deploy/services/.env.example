# Service droplet env — copy to /opt/blastr-services/.env on the droplet
# and fill in real values. NOT committed to git.

# Postgres password for GlitchTip's database.
POSTGRES_PASSWORD=

# 50-byte random string for GlitchTip secret signing.
# Generate: openssl rand -hex 64
GLITCHTIP_SECRET_KEY=

# SMTP URL for GlitchTip email notifications (forgot pwd, alerts).
# Format: smtp://user:pass@smtp.host.com:587?tls=true
# Optional — set to "" to disable email.
GLITCHTIP_EMAIL_URL=

# Grafana admin login (used for first login then change in UI).
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=

# Private VPC interface IP of this droplet (e.g. 10.114.0.5).
# Loki binds to this IP only so it's reachable from DOKS pods over VPC
# but not from the public internet. Find via: ip addr show eth1
VPC_INTERFACE_IP=

# ---------------------------------------------------------------------------
# Pulse Worker — same blastr app image as k8s. Mirror values from the
# blastr-env sealed Secret in k8s; obs droplet shares the same VPC and so
# reaches the same Managed MySQL + Managed Valkey instances.
#
# Extract from k8s:
#   kubectl get secret blastr-env -n blastr -o json | python3 -c "
#   import json, sys, base64
#   data = json.load(sys.stdin)['data']
#   for k in ['APP_KEY','DB_HOST','DB_PORT','DB_DATABASE','DB_USERNAME',
#            'DB_PASSWORD','REDIS_HOST','REDIS_PORT','REDIS_PASSWORD']:
#       print(f'{k}={base64.b64decode(data[k]).decode()}')"
# ---------------------------------------------------------------------------

# Image tag — pin to the same version deployed in k8s.
# Check: kubectl get deploy/blastr-web -n blastr -o jsonpath='{.spec.template.spec.containers[0].image}'
APP_IMAGE_TAG=

APP_KEY=
DB_HOST=
DB_PORT=
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=
REDIS_HOST=
REDIS_PORT=
REDIS_PASSWORD=
